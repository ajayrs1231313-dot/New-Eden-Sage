{
  "name": "new-eden-sage",
  "version": "1.1.12",
  "private": true,
  "license": "MIT",
  "author": "New Eden Sage contributors",
  "description": "A private, local-first EVE Online assistant.",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev-ensure.cjs",
    "dev:electron": "tsc -p tsconfig.electron.json --watch --preserveWatchOutput",
    "dev:app": "node scripts/electron-dev-watch.cjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "build": "tsc --noEmit && tsc -p tsconfig.electron.json && vite build",
    "preview": "vite preview",
    "icon": "node scripts/generate-icon.cjs",
    "dist:win": "npm run verify:release-resources && npm run icon && npm run build && electron-builder --win nsis --publish never",
    "dist:linux": "npm run verify:release-resources && npm run icon && npm run build && electron-builder --linux AppImage deb --publish never",
    "verify:release-resources": "node scripts/verify-release-resources.cjs",
    "fitting:refresh-bundle": "tsc -p tsconfig.electron.json && node scripts/build-fitting-bundle.cjs",
    "test:navigation": "tsc -p tsconfig.electron.json && node tests/navigation/run-all.cjs",
    "dev:stack": "concurrently -k \"vite --port 42814 --strictPort\" \"npm:dev:electron\" \"npm:dev:app\"",
    "test:system-news": "node --experimental-strip-types tests/system-news/killmail-windows.test.mjs",
    "test:claude-mcpb": "node --experimental-strip-types tests/claude/mcpb.test.mjs",
    "test:mcp-guidance": "node --experimental-strip-types tests/mcp/ai-guidance.test.mjs",
    "test:wormhole": "tsc -p tsconfig.electron.json && node --experimental-strip-types tests/wormhole/run-all.mjs",
    "test:planetary": "tsc -p tsconfig.electron.json && node tests/planetary/run-all.cjs",
    "test:progression": "node --experimental-strip-types tests/progression/activity-ship-rules.test.mjs && node --experimental-strip-types tests/progression/fit-cluster-selection.test.mjs",
    "test:activity-accuracy": "tsc -p tsconfig.electron.json && node tests/progression/activity-readiness-accuracy.test.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "adm-zip": "^0.6.0",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "react": "latest",
    "react-dom": "latest"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.3",
    "typescript": "latest",
    "vite": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "com.newedensage.desktop",
    "productName": "New Eden Sage",
    "publish": [
      {
        "provider": "github",
        "owner": "ajayrs1231313-dot",
        "repo": "New-Eden-Sage"
      }
    ],
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "README.md",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "vendor/tunnel-client",
        "to": "tunnel-client"
      },
      {
        "from": "vendor/fitting-data",
        "to": "fitting-data",
        "filter": [
          "fitting-dogma-prepared-v1.json.gz",
          "fitting-catalogue-prepared-v1.json.gz"
        ]
      },
      {
        "from": "vendor/market-data",
        "to": "market-data",
        "filter": [
          "market-static-prepared-v1.json.gz"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "artifactName": "New-Eden-Sage-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "New Eden Sage contributors <ajayrs1231313-dot@users.noreply.github.com>",
      "icon": "build/icon.png",
      "artifactName": "New-Eden-Sage-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "New Eden Sage"
    }
  }
}
